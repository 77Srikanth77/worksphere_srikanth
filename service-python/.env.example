# SQLite file, relative to the service-python folder (shared with api-node)
DB_FILE=../db/worksphere.db
# Must match INTERNAL_API_KEY in api-node/.env
INTERNAL_API_KEY=change_this_shared_key
# Daily alert run time (24h, server local time)
ALERT_HOUR=6
ALERT_MINUTE=0
# Days before expiry at which alerts fire
ALERT_THRESHOLDS=180,90,60,30
# SMTP for alert emails. Leave SMTP_HOST empty to print emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=worksphere-alerts@example.com
# Roles whose users receive alert emails
ALERT_ROLES=LEGAL,CEO
# Vendor follow-ups (business days). Must match api-node/.env
FOLLOW_UP_DUE_DAYS=3
FOLLOW_UP_OVERDUE_DAYS=5
# Escalate an employee's unanswered "request update" after this many business days
UPDATE_REQUEST_ESCALATE_DAYS=2
FOLLOWUP_ESCALATION_ROLES=MARKETING_MANAGER,CEO
# Weekday follow-up digest time (hour, 24h)
FOLLOWUP_HOUR=8
# Timesheet reminders (day: mon..sun, hour 24h). Employees get their own list; these roles get a summary.
TIMESHEET_REMINDER_DAY=fri
TIMESHEET_REMINDER_HOUR=14
TIMESHEET_LOOKBACK_WEEKS=8
TIMESHEET_REMINDER_ROLES=HR
# Employee document expiry reminders (plus the employee)
DOC_ALERT_ROLES=HR,LEGAL
