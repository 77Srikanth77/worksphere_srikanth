PORT=4000
# SQLite file, relative to the api-node folder (shared with service-python)
DB_FILE=../db/worksphere.db
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
# FastAPI service (alerts + reports)
PY_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=change_this_shared_key
# Used only by `npm run set-passwords`
DEMO_PASSWORD=Password@123
CORS_ORIGIN=http://localhost:5173
# Vendor follow-up rules (business days since the agent's last activity)
FOLLOW_UP_DUE_DAYS=3
FOLLOW_UP_OVERDUE_DAYS=5
